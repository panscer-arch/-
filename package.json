{
  "name": "lifecoding-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @lifecoding/web",
    "build": "npm run build --workspace @lifecoding/web",
    "lint": "npm run lint --workspace @lifecoding/web",
    "typecheck": "npm run typecheck --workspace @lifecoding/web",
    "dev:web": "npm run dev --workspace @lifecoding/web",
    "dev:api": "npm run dev --workspace @lifecoding/api-gateway",
    "dev:admin": "npm run dev --workspace @lifecoding/admin",
    "dev:orchestrator": "npm run dev --workspace @lifecoding/orchestrator",
    "build:orchestrator": "npm run build --workspace @lifecoding/orchestrator"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
