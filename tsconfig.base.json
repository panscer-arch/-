{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@lifecoding/shared-types": ["packages/shared-types/src/index.ts"],
      "@lifecoding/config": ["packages/config/src/index.ts"],
      "@lifecoding/event-bus": ["packages/event-bus/src/index.ts"],
      "@lifecoding/feature-flags": ["packages/feature-flags/src/index.ts"],
      "@lifecoding/ui": ["packages/ui/src/index.ts"],
      "@lifecoding/domain-identity": ["packages/domain-identity/src/index.ts"],
      "@lifecoding/domain-profile": ["packages/domain-profile/src/index.ts"],
      "@lifecoding/domain-rules": ["packages/domain-rules/src/index.ts"],
      "@lifecoding/domain-progress": ["packages/domain-progress/src/index.ts"],
      "@lifecoding/domain-diary": ["packages/domain-diary/src/index.ts"],
      "@lifecoding/domain-feed": ["packages/domain-feed/src/index.ts"],
      "@lifecoding/domain-gamification": ["packages/domain-gamification/src/index.ts"],
      "@lifecoding/domain-notifications": ["packages/domain-notifications/src/index.ts"],
      "@lifecoding/domain-recommendations": ["packages/domain-recommendations/src/index.ts"]
    }
  }
}
